# 로컬: 이 파일을 .env 로 복사해서 값을 채우세요.
# Vercel: 같은 이름으로 Project Settings > Environment Variables 에 등록하세요.

# [필수] 공공데이터포털 > 소상공인시장진흥공단_상가(상권)정보_API 인증키 (Decoding 키 권장)
SBIZ_API_KEY=

# [지도] 카카오 개발자센터 > 플랫폼 키 > JavaScript 키 (브라우저에 노출됨, 도메인 등록 필요)
KAKAO_JS_KEY=
# [선택] 카카오 REST API 키 (서버 전용: 목록에 없는 지명 위치 검색 정확도 향상)
KAKAO_REST_API_KEY=

# [공유 저장] Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# [AI 검색] Google AI Studio(https://aistudio.google.com/apikey) 무료 Gemini 키 — 없으면 동네·지명·가게 이름 검색만 동작
GEMINI_API_KEY=
# 선택: 모델 (기본 gemini-3.5-flash-lite)
GEMINI_MODEL=

# [로그] IP를 해시할 때 섞는 임의 문자열 (아무 값이나 길게)
LOG_SALT=

PORT=3000
